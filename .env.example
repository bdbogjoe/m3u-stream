# Single playlist:
M3U_URL=https://example.com/playlist.m3u
# Multiple playlists (comma-separated). Each item can be a bare URL or name=url.
# M3U_URL=france=https://example.com/france.m3u,sport=https://example.com/sport.m3u
TV_IP=192.168.1.101
# Optional:
# WEB_PORT=8080
# RELAY_PORT=8888
# HOST_IP=192.168.1.42
# Image to use. Default builds locally as `m3u-stream:local`.
# To pull from Docker Hub instead, set this to your published tag, e.g.:
# IMAGE=bdbogjoe/m3u-stream:latest
# Note: HOST_IP is auto-detected in host networking. In bridge mode you
# MUST set it to the host's LAN IP, because the container's own IP is
# behind the Docker bridge and unreachable from the TV.
