# Single playlist:
M3U_URL=https://example.com/playlist.m3u
# Multiple playlists (comma-separated). Each item can be a bare URL or name=url.
# M3U_URL=france=https://example.com/france.m3u,sport=https://example.com/sport.m3u
TV_IP=192.168.1.101
# Optional:
# WEB_PORT=8080
# RELAY_PORT=8888
# HOST_IP=192.168.1.42
# Image to use. Default builds locally as `m3u-stream:local`.
# To pull from Docker Hub instead, set this to your published tag, e.g.:
# IMAGE=bdbogjoe/m3u-stream:latest
# Note: HOST_IP is auto-detected in host networking. In bridge mode you
# MUST set it to the host's LAN IP, because the container's own IP is
# behind the Docker bridge and unreachable from the TV.
#
# RELAY_BASE_URL — override the base URL the browser uses to reach the
# relay (DLNA cast always uses the LAN URL regardless). Used only when
# the request comes through a reverse proxy (X-Forwarded-* present).
# Set this when the relay is behind a reverse proxy / TLS terminator:
# RELAY_BASE_URL=https://stream.example.com
#
# WEB_BASE_URL — public URL for the web UI itself. Used in the relay's
# 503 "no stream running" page so the link sends users to the proxied
# URL when they hit the relay through the proxy. LAN clients still get
# the http://$HOST_IP:$WEB_PORT link.
# WEB_BASE_URL=https://m3u.example.com
